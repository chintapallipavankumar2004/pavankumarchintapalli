{
  "name": "pavan-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --experimental-require-module --import tsx --test tests/unit.test.ts",
    "test:rules": "node scripts/run-rules.cjs",
    "test:rules:run": "node --experimental-require-module --import tsx --test tests/firestore.rules.test.ts",
    "test:browser": "node scripts/run-rules.cjs --browser",
    "admin:provision": "node --experimental-require-module --env-file=.env.local --import tsx scripts/provision-admin.ts"
    ,"cms:seed": "node --experimental-require-module --env-file=.env.local --import tsx scripts/seed-cms.ts",
    "cms:migrate-gallery": "node --experimental-require-module --env-file=.env.local --import tsx scripts/migrate-project-gallery.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.30.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
