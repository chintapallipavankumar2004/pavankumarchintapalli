# Public Firebase web app configuration. VITE_ values are bundled into the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional initial resume URL. Leave blank until the actual PDF is available.
# Admin settings override this value. /resume.pdf requires public/resume.pdf.
VITE_RESUME_URL=

# SERVER ONLY. Never prefix these with VITE_. Never commit real credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service account private_key, with literal \n escapes inside quotes.
FIREBASE_PRIVATE_KEY=
# Used only by the local provision-admin script. No client-side admin grants.
FIREBASE_ADMIN_UID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_PRESET=
CLOUDINARY_RESUME_PRESET=
# Comma-separated exact origins, no trailing slash. Include localhost for vercel dev.
ALLOWED_ORIGINS=http://localhost:3000
# Generate a random secret (at least 32 random bytes). Used to hash IPs for rate limits.
ENQUIRY_RATE_LIMIT_SECRET=
# Firebase Admin dependencies may need this under Vercel's Node runtime.
NODE_OPTIONS=--experimental-require-module
